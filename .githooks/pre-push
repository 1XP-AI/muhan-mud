#!/usr/bin/env bash
set -Eeuo pipefail
root="$(git rev-parse --show-toplevel)"
has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$local_sha" != "$(git rev-parse HEAD)" ]]; then
    echo 'local-first: check out the branch being pushed so its code can be tested.' >&2
    exit 1
  fi
  has_update=1
done
[[ "$has_update" == 1 ]] || exit 0
exec bash "$root/scripts/check-local-before-push.sh"
