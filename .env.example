# Docker Compose publishes only the browser-facing gateway.
GATEWAY_PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public project coordinates are used to validate browser access tokens.
# Never place a service_role or Supabase secret key here.
SUPABASE_URL=https://your-project.supabase.co
# Optional internal GoTrue base URL. Kubernetes uses the ClusterIP service.
SUPABASE_AUTH_URL=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
