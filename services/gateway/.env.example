HOST=0.0.0.0
PORT=8080
NODE_ENV=development

MUD_HOST=127.0.0.1
MUD_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Disabled by default. Enables only /onboarding with subprotocol muhan.onboarding.v1.
MUD_ONBOARDING_ENABLED=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Private direct PostgREST origin; never expose this or the following values to browsers.
SUPABASE_INTERNAL_REST_URL=http://supabase-postgrest:3000
SUPABASE_SERVICE_ROLE_KEY=service_role_replace_me
MUD_ADMISSION_SECRET=replace-with-32-to-512-printable-ascii-bytes
GATEWAY_INSTANCE_ID=gateway-1

AUTH_TIMEOUT_MS=10000
TCP_CONNECT_TIMEOUT_MS=5000
MUD_ADMISSION_TIMEOUT_MS=5000
MAX_CONNECTIONS=200
MAX_FRAME_BYTES=16384
INPUT_BYTES_PER_SECOND=4096
MAX_BUFFERED_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
