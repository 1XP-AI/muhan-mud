{
  "name": "muhan-web-mud",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @muhan/web dev",
    "dev:web": "pnpm --filter @muhan/web dev",
    "dev:gateway": "pnpm --filter @muhan/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:legacy:unit": "make -C src unit-test",
    "test:legacy:scenario": "./scripts/run-ai-scenario.sh",
    "test:legacy": "pnpm test:legacy:unit && pnpm test:legacy:scenario",
    "test:browser": "playwright test --config=tests/browser-e2e/playwright.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  }
}
